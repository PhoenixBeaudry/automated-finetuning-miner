# Copy to .env for local use; configure RunPod secrets at runtime.
# Never use real credentials as Docker build arguments or image ENV values.
HUGGINGFACE_TOKEN=
HUGGINGFACE_USERNAME=
WANDB_TOKEN=
WANDB_PROJECT=Gradients
PYTHONPATH=/workspace:/workspace/training

# Optional: private S3 / Cloudflare R2 dataset access
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
AWS_DEFAULT_REGION=us-east-1
AWS_SESSION_TOKEN=

# Miner environment only
ENDPOINT_API_KEY=
